{
  "name": "iobroker.harvia-fenix",
  "version": "0.5.1",
  "description": "ioBroker adapter for Harvia Fenix Sauna Control",
  "type": "commonjs",
  "author": {
    "name": "meistermopper",
    "email": "meister.mopper@gmail.com"
  },
  "homepage": "https://github.com/meistermopper/ioBroker.harvia-fenix",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "Harvia",
    "Fenix",
    "Sauna"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meistermopper/ioBroker.harvia-fenix.git"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "axios": "^1.18.1"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-changelog": "^5.2.1",
    "@alcalzone/release-script-plugin-git": "^5.2.0",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@alcalzone/release-script-plugin-package": "^5.2.0",
    "@alcalzone/release-script-plugin-version": "^5.2.0",
    "@biomejs/biome": "^2.5.1",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/dev-server": "^0.8.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.2.1",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^22.13.0",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "main": "build/main.js",
  "files": [
    "admin",
    "build",
    "io-package.json",
    "LICENSE",
    "README.md",
    "README_de.md"
  ],
  "scripts": {
    "test:integration": "cross-env NODE_OPTIONS=\"--no-experimental-detect-module\" npm_config_engine_strict=false mocha test/integration --exit",
    "test:unit": "node test/run-unit-tests.js",
    "test:ts": "tsc --noEmit",
    "test:package": "mocha test/package --exit",
    "test": "npm run build && npm run test:unit && npm run test:integration",
    "check": "biome check .",
    "format": "eslint src --fix",
    "check:repo": "npx @iobroker/repochecker meistermopper/ioBroker.harvia-fenix main --local",
    "test:local": "npm run lint && npm run test:ts && npm run test:package && npm test && npm run check:repo",
    "translate": "translate-adapter",
    "sync-docs": "node scripts/sync-docs.js",
    "build": "npm run sync-docs && npm run format && node -e \"require('fs').rmSync('build', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json --watch",
    "dev": "dev-server watch",
    "lint": "biome check . && eslint src",
    "release": "release-script --addPlaceholder",
    "release-before-check": "node scripts/check-wip.js && npm run test:local",
    "release-before-commit": "npm run translate && npm run manage-changelogs && npm run sync-docs && npm run format && git add -A",
    "manage-changelogs": "node scripts/manage-changelogs.js"
  },
  "bugs": "https://github.com/meistermopper/ioBroker.harvia-fenix/issues",
  "readmeFilename": "README.md",
  "overrides": {
    "glob": "11.1.0",
    "minimatch": "10.0.1"
  }
}
